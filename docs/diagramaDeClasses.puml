@startuml DiagramaClasses
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title HubSpace Coworking - Diagrama de Classes (Etapa 2)

package modelo {

  interface Locavel {
    + getCodigo(): int
    + calcularValorLocacao(horas: int): double
    + getDescricaoItem(): String
  }

  abstract class Espaco implements Locavel {
    - codigo: int
    - nome: String
    - capacidade: int
    # valorHoraBase: double
    + Espaco(codigo: int, nome: String, capacidade: int, valorHoraBase: double)
    + {abstract} calcularTarifa(horas: int): double
    + calcularValorLocacao(horas: int): double
    + getCodigo(): int
    + getDescricaoItem(): String
    + toString(): String
  }

  class EstacaoTrabalho extends Espaco {
    - possuiMonitorExtra: boolean
    + EstacaoTrabalho(codigo: int, nome: String, capacidade: int, valorHoraBase: double, possuiMonitorExtra: boolean)
    + calcularTarifa(horas: int): double
  }

  class SalaReuniao extends Espaco {
    - possuiVideoconferencia: boolean
    + SalaReuniao(codigo: int, nome: String, capacidade: int, valorHoraBase: double, possuiVideoconferencia: boolean)
    + calcularTarifa(horas: int): double
  }

  class Auditorio extends Espaco {
    - taxaLimpeza: double
    + Auditorio(codigo: int, nome: String, capacidade: int, valorHoraBase: double, taxaLimpeza: double)
    + calcularTarifa(horas: int): double
  }

  class Equipamento implements Locavel {
    - codigo: int
    - nome: String
    - valorHora: double
    + Equipamento(codigo: int, nome: String, valorHora: double)
    + getCodigo(): int
    + calcularValorLocacao(horas: int): double
    + getDescricaoItem(): String
    + toString(): String
  }

  class Cliente {
    - cpf: String
    - nome: String
    - email: String
    + Cliente(cpf: String, nome: String, email: String)
    + toString(): String
  }

  class Reserva {
    - id: int
    - data: LocalDate
    - horaInicio: LocalTime
    - duracaoHoras: int
    - cliente: Cliente
    - itensLocados: List<Locavel>
    - pagamento: Pagamento
    + Reserva(id: int, data: LocalDate, horaInicio: LocalTime, duracaoHoras: int, cliente: Cliente)
    + adicionarItem(item: Locavel): void throws RegraNegocioException
    + calcularValorTotal(): double
    + getHoraFim(): LocalTime
    + itemEmComum(outra: Reserva): Locavel
    + conflitaCom(outra: Reserva): boolean
    + registrarPagamento(forma: FormaPagamento, valorPago: double): void throws PagamentoInvalidoException
    + estaPaga(): boolean
    + toString(): String
  }

  class Pagamento {
    - valor: double
    - forma: FormaPagamento
    - dataHora: LocalDateTime
    + Pagamento(valor: double, forma: FormaPagamento)
    + toString(): String
  }

  enum FormaPagamento {
    PIX
    CARTAO_CREDITO
    CARTAO_DEBITO
    DINHEIRO
  }
}

package excecao {

  class RegraNegocioException <<checked>> {
    + RegraNegocioException(mensagem: String)
  }

  class ConflitoHorarioException extends RegraNegocioException {
    + ConflitoHorarioException(item: Locavel, data: LocalDate, horaInicio: LocalTime)
  }

  class PagamentoInvalidoException extends RegraNegocioException {
    + PagamentoInvalidoException(mensagem: String)
  }

  class ItemNaoEncontradoException extends RegraNegocioException {
    + ItemNaoEncontradoException(codigo: int)
  }
}

package servico {

  class EspacoService {
    - espacos: List<Espaco>
    + cadastrar(espaco: Espaco): void throws RegraNegocioException
    + listar(): List<Espaco>
    + buscarEspaco(codigo: int): Espaco throws ItemNaoEncontradoException
    + buscarEspaco(nome: String): List<Espaco>
    + alterarValorHora(codigo: int, novoValor: double): void throws ItemNaoEncontradoException
    + remover(codigo: int): void throws ItemNaoEncontradoException
    + gerarTabelaPrecos(horas: int): String
  }

  class ReservaService {
    - reservas: List<Reserva>
    + registrarReserva(reserva: Reserva): void throws RegraNegocioException
    + cancelarReserva(id: int): void throws RegraNegocioException
    + pagarReserva(id: int, forma: FormaPagamento, valorPago: double): void throws RegraNegocioException
    + buscarReserva(id: int): Reserva throws ItemNaoEncontradoException
    + listarReservasOrdenadas(): List<Reserva>
    + calcularFaturamento(): double
  }
}

java.lang.Exception <|-- RegraNegocioException

' --- Associacao ---
Cliente "1" -- "0..*" Reserva : realiza >

' --- Agregacao: o item existe sem a reserva ---
Reserva "0..*" o-- "1..*" Locavel : inclui >

' --- Composicao: o pagamento nao existe sem a reserva ---
Reserva "1" *-- "0..1" Pagamento : quitada por >
Pagamento "0..*" --> "1" FormaPagamento : usa >

' --- Agregacoes dos servicos ---
ReservaService "1" o-- "0..*" Reserva : gerencia >
EspacoService "1" o-- "0..*" Espaco : cataloga >

' --- Dependencias (R3) ---
ReservaService ..> ConflitoHorarioException : <<throws>>
ReservaService ..> ItemNaoEncontradoException : <<throws>>
EspacoService ..> ItemNaoEncontradoException : <<throws>>
Reserva ..> PagamentoInvalidoException : <<throws>>

@enduml